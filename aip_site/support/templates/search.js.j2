{# This file generates the search index used by the search page.
   The search implementation is in support/assets/js/search/search.js. -#}
var tipuesearch = {'pages': [
{% for aip in site.aips.values() -%}
  {
    'title': {{ aip.title | striptags | tojson }},
    'text': {{ aip.content.html | striptags | tojson }},
    'tags': '',
    'url': {{ (site.relative_uri ~ aip.relative_uri) | tojson }},
  },
{% endfor -%}
]};
